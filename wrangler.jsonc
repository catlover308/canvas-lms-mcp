{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "canvas-mcp-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "canvas-mcp-cf.brycel.net",
      "custom_domain": true,
    },
    {
      "pattern": "canvas-mcp.brycel.net",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": [],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "CANVAS_BASE_URL": "https://canvas.pasadena.edu",
    "CANVAS_COC_BASE_URL": "https://coc.instructure.com",
  },
  "secrets": {
    "required": ["CANVAS_API_TOKEN", "MCP_ACCESS_TOKEN"],
  },
}
